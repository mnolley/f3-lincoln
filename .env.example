# Slack bot for backblast feed (conversations.history)
# Required scopes (reinstall app after changing scopes so the token updates):
#   channels:history  – read #backblast
#   users:read        – resolve F3 display names on rosters
#   users.profile:read – profile fields (optional but recommended)
SLACK_BOT_TOKEN=xoxb-your-bot-token
# #backblast channel ID (e.g. C01ULPXHX52)
SLACK_BACKBLAST_CHANNEL_ID=

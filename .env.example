# Slack bot for backblast feed (conversations.history)
# Required scopes (reinstall app after changing scopes so the token updates):
#   channels:history  – read #backblast
#   users:read        – resolve F3 display names on rosters
#   users.profile:read – profile fields (optional but recommended)
SLACK_BOT_TOKEN=xoxb-your-bot-token
# #backblast channel ID (e.g. C01ULPXHX52)
SLACK_BACKBLAST_CHANNEL_ID=

# Vercel Blob — durable backblast archive (primary)
# Linked automatically when you connect a Blob store to the Vercel project:
#   vercel blob create-store f3-lincoln-bb --access private --yes --environment production
BLOB_READ_WRITE_TOKEN=

# Optional Supabase secondary archive
# Run database/backblasts.sql once, then set:
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
